{
    "id": "editorial_cover",
    "name": { "en": "Editorial Cover", "zh": "杂志封面" },
    "version": 3,
    "editable": true,
    "layout": {
        "position": "BORDER",
        "designSize": { "width": 3072, "height": 4096 },
        "height": 210,
        "borderWidth": 210,
        "borderHeight": 210,
        "backgroundColor": "#FFD600",
        "borderColor": "#FFD600",
        "padding": 0,
        "elementSpacing": 0
    },
    "elements": [
        {
            "type": "text", "textType": "DATE", "format": "yyyy.MM",
            "alignment": "CENTER", "fontSize": 48, "color": "#FFFFFF",
            "style": { "letterSpacingEm": 0.3 },
            "placement": { "x": 0.5, "y": 0.05, "widthFraction": 0.8 }
        },
        {
            "type": "text", "textType": "CUSTOM",
            "textMap": { "en": "NATIONAL\nGEOGRAPHIC", "zh": "NATIONAL\nGEOGRAPHIC" },
            "alignment": "CENTER", "fontSize": 240, "fontWeight": "BOLD", "color": "#FFFFFF",
            "style": { "lineSpacingMultiplier": 0.9 },
            "placement": { "x": 0.5, "y": 0.12, "widthFraction": 0.9 }
        },
        {
            "type": "text", "textType": "CUSTOM",
            "textMap": { "en": "A NEW PERSPECTIVE", "zh": "用镜头发现另一种视角" },
            "alignment": "CENTER", "fontSize": 60, "color": "#FFFFFF",
            "style": { "letterSpacingEm": 0.16 },
            "placement": { "x": 0.5, "y": 0.235, "widthFraction": 0.9 }
        },
        {
            "type": "text", "textType": "CUSTOM",
            "textMap": { "en": "INTO\nTHE WILD", "zh": "山野\n之间" },
            "alignment": "CENTER", "fontSize": 410, "fontWeight": "BOLD", "color": "#FFF3CA",
            "style": {
                "lineSpacingMultiplier": 0.9,
                "gradientEndColor": "#AE812B",
                "strokeWidth": 3, "strokeColor": "#EBD294",
                "shadowRadius": 16, "shadowOffsetX": 12, "shadowOffsetY": 18, "shadowColor": "#CC241C11"
            },
            "placement": { "x": 0.5, "y": 0.455, "widthFraction": 0.94 }
        },
        {
            "type": "text", "textType": "CUSTOM",
            "textMap": { "en": "Follow the light.\nDiscover the stories beyond the horizon.", "zh": "追随光线的方向\n记录山川之间的故事" },
            "alignment": "CENTER", "fontSize": 80, "color": "#FFFFFF",
            "style": {
                "letterSpacingEm": 0.12, "lineSpacingMultiplier": 1.4,
                "shadowRadius": 8, "shadowOffsetY": 4, "shadowColor": "#CC000000"
            },
            "placement": { "x": 0.5, "y": 0.68, "widthFraction": 0.88 }
        },
        {
            "type": "logo", "logoType": "BRAND", "overrideSource": "photon",
            "alignment": "START", "width": 900, "light": true,
            "placement": { "x": 0.03, "y": 0.95, "anchorX": 0, "widthFraction": 0.88 }
        },
        {
            "type": "divider", "orientation": "HORIZONTAL",
            "length": 500, "thickness": 10, "color": "#FFD600",
            "placement": { "x": 0.03, "y": 0.98, "anchorX": 0 }
        }
    ]
}
